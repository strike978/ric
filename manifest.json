{
  "manifest_version": 3,
  "name": "Relatives in Common",
  "version": "0.1.1",
  "description": "Proof of concept for viewing a 23andMe profile's relatives in common.",
  "permissions": [
    "notifications"
  ],
  "host_permissions": [
    "https://*.23andme.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_title": "Relatives in Common",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
